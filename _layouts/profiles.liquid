---
layout: page
---
<div class="post">
  <article>
    {% if page.profiles %}
      <h2 class="project-title" style="margin-top: 20px;">Current Members</h2>
      {% assign current_members = page.profiles | where: 'active', true %}

      {% assign leads_current = current_members | where: 'category', 'lead' %}
      {% assign postdocs_current = current_members | where: 'category', 'postdoc' %}
      {% assign phd_current = current_members | where: 'category', 'phd' %}
      {% assign msc_current = current_members | where: 'category', 'msc' %}
      {% assign ug_current = current_members | where: 'category', 'ug' %}
      {% assign ra_current = current_members | where: 'category', 'ra' %}

      {% assign ordered_current_members = leads_current
        | concat: postdocs_current
        | concat: phd_current
        | concat: msc_current
        | concat: ug_current
        | concat: ra_current
      %}

      {% for profile in ordered_current_members %}
        <hr>
        <div class="profile float-{% if profile.align == 'left' %}left{% else %}right{% endif %}">
          {% if profile.image %}
            {% assign profile_image_path = profile.image | prepend: 'assets/img/' %}
            {% if profile.image_circular %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid z-depth-1 rounded' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px) 30vw, 95vw"{% endcapture %}
            {% include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile.image %}
          {% endif %}
          {% if profile.website %}
            <div class="more-info" style="width: 100%; text-align: center;">
              <a href="{{ profile.website }}" target="_blank" rel="noopener" aria-label="Website"> <i class="fa-solid fa-globe"></i> Website </a>
            </div>
          {% endif %}
        </div>

        <div class="clearfix">
          {% if profile.name %}
            <h5>{{ profile.name }}</h5>
          {% endif %}
          {% if profile.role %}
            <p class="text-muted" style="font-style: italic; font-size: 1.1rem; margin-bottom: 0;">{{ profile.role | join: ' · ' }}</p>
          {% endif %}
          {% if profile.university %}
            <p class="text-muted" style="margin-top: 0; font-size: 1.1rem; font-style: italic;">{{ profile.university | join: ' & ' }}</p>
          {% endif %}
          {% if profile.role_secondary %}
            <p class="text-muted" style="font-style: italic; font-size: 1.1rem; margin-top: 8px; margin-bottom: 0;">{{ profile.role_secondary | join: ' · ' }}</p>
          {% endif %}
          {% if profile.university_secondary %}
            <p class="text-muted" style="margin-top: 0; font-size: 1.1rem; font-style: italic;">{{ profile.university_secondary | join: ' & ' }}</p>
          {% endif %}

          {% if profile.papers %}
            {% capture papers_regex %}^({{ profile.papers | join: "|" }})${% endcapture %}
            <h5 class="text-muted" style="margin-top: 12px; margin-bottom: 4px;">Selected Publications</h5>
            <div class="publications" style="margin-top: 0;">
              {% bibliography --group_by none --query @*[key~={{ papers_regex }}] %}
            </div>
          {% endif %}

          {% if profile.content %}
            {% capture profile_content %}{% include_relative {{ profile.content }} %}{% endcapture %}
            {{ profile_content | markdownify }}
          {% else %}
            {{ content }}
          {% endif %}
        </div>
      {% endfor %}

      <h2 class="project-title" style="margin-top: 60px;">Alumni & Ex-Members</h2>

      {% assign ex_members = page.profiles | where: 'active', false %}

      {% assign postdocs_alumni = ex_members | where: 'category', 'postdoc' %}
      {% assign phd_alumni = ex_members | where: 'category', 'phd' %}
      {% assign msc_alumni = ex_members | where: 'category', 'msc' %}
      {% assign ug_alumni = ex_members | where: 'category', 'ug' %}
      {% assign ra_alumni = ex_members | where: 'category', 'ra' %}

      {% if postdocs_alumni.size > 0 %}
